# Sao chép file này thành .env (không commit .env)

# ===== Database =====
# SqlServer (mặc định) | Sqlite (demo mang đi, không cần cài SQL Server)
DB_PROVIDER=SqlServer
CONNECTION_STRING=Server=localhost;Database=WebDemo_WebDanhMucDemo;Trusted_Connection=True;TrustServerCertificate=True
# SQL Server có tên instance, vd SQL Express:
# CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=WebDemo_WebDanhMucDemo;Trusted_Connection=True;TrustServerCertificate=True
# Với Sqlite (file tạo trong src/API/App_Data):
# CONNECTION_STRING=Data Source=App_Data/web-danh-muc-demo.db

# ===== JWT =====
# JWT_KEY tối thiểu 32 ký tự; script tạo dự án tự sinh khóa ngẫu nhiên
JWT_KEY=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_ISSUER=web-danh-muc-demo
JWT_AUDIENCE=web-danh-muc-demo
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:3101

# ===== Demo =====
# true: bật /api/demo/*, nạp dữ liệu mẫu nghiệp vụ khi DB chưa có, tự đặt lại theo DEMO_RESET_CRON.
# Tạo bảng/migration và seed quyền, vai trò, tài khoản demo luôn chạy lúc khởi động.
DEMO_MODE=true
# Mật khẩu chung của tài khoản demo admin / quanly / nhanvien
DEMO_PASSWORD=Demo@123
# Lịch tự đặt lại dữ liệu (cron 5 trường, giờ Việt Nam), để trống để tắt. Ví dụ 3h sáng mỗi ngày:
DEMO_RESET_CRON=0 3 * * *
