# Sao chép file này thành .env.local (không commit .env.local)

NEXT_PUBLIC_APP_NAME=Danh mục Demo

# mock: chạy bằng dữ liệu mẫu trong trình duyệt, không cần BE
# api : gọi BE thật tại NEXT_PUBLIC_API_URL
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=https://localhost:7101

# Chỉ phía máy chủ Next.js (không lộ ra trình duyệt, đọc lúc chạy): địa chỉ BE qua mạng nội bộ khi chạy
# Docker (deploy/docker-compose.yml đặt http://be:8080). Bỏ trống thì dùng NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=

# Thanh công cụ demo (đổi vai trò, đặt lại dữ liệu, đổi màu)
NEXT_PUBLIC_DEMO_TOOLBAR=true
# Bản quảng bá không có BE: true thì ẩn mọi lối vào đăng nhập, /login và khu quản trị chuyển về trang chủ
NEXT_PUBLIC_PUBLIC_ONLY=false
# Mật khẩu tài khoản demo khi chạy chế độ mock (trùng DEMO_PASSWORD của BE)
NEXT_PUBLIC_DEMO_PASSWORD=Demo@123

# Địa chỉ công khai của trang (dùng cho sitemap, link chia sẻ, ảnh chia sẻ). Để trống thì lấy theo host của request.
# NEXT_PUBLIC_SITE_URL=https://demo.pum.vn

# Build cho Docker (FE/Dockerfile đã đặt sẵn): NEXT_OUTPUT=standalone. Vercel/Cloudflare không đặt.
